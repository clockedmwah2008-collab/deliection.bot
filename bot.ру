async def on_ready():
    print(f'Бот {bot.user} запущен!')
    # ЗАМЕНИТЕ ID КАНАЛА НА ВАШ
    channel = bot.get_channel(123456789012345678) 
    if channel:
        embed = discord.Embed(
            title="Daisy.exe Scripts Panel",
            description="Click Get Script to access the script. Copy and paste all in your executor.\n\n**Instructions**\n1. Click Get Script\n2. Copy and paste the loader into an executor\n3. Enjoy <3",
            color=0xeb459e
        )
        embed.set_footer(text="Powered by @religiousbinding - dm for key systems")
        await channel.send(embed=embed, view=PanelView())

bot.run(TOKEN)